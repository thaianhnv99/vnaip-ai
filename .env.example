# vnaip-dedup: no Sota secret or private key is required.
PORT=8787
# Public, non-secret override for local/self-hosted Core JWKS discovery.
# SOTA_CORE_ORIGIN=http://localhost:3651

# --- check-duplicates tool configuration ---
# Số ứng viên tối đa gửi từ VNAIP BE để chấm điểm. Giá trị khởi điểm chưa
# được tối ưu; chỉnh theo nhu cầu thực tế và deadline của tool (timeoutMs).
VNAIP_CANDIDATE_LIMIT=30

# Mock mode: "true" (mặc định) dùng dữ liệu/điểm giả để phát triển/test khi
# chưa có API contract thật. PHẢI đặt "false" trước khi dùng production, và
# chỉ sau khi đã cấu hình đủ biến bên dưới.
VNAIP_MOCK_MODE=true
LLM_MOCK_MODE=true

# VNAIP BE — cơ chế xác thực server-to-server THẬT chưa được xác nhận.
# KHÔNG dùng invocation JWT của SotaAgents cho chiều gọi này.
VNAIP_BE_BASE_URL=http://localhost:3000
# VNAIP_BE_SERVICE_TOKEN=__secret__
# VNAIP_BE_TIMEOUT_MS=5000

# Model/LLM provider — contract thật chưa được xác nhận (endpoint dưới đây
# giả định dạng OpenAI-compatible chat completion).
# LLM_SCORER_BASE_URL=https://llm-provider.example.com
# LLM_SCORER_API_KEY=__secret__
# LLM_SCORER_MODEL=__model-name__
# LLM_SCORER_TIMEOUT_MS=8000
# LLM_SCORER_BATCH_SIZE=10

# Tạm thời: ghi claims đã xác thực của mỗi lời gọi hợp lệ (không ghi token) để
# xem claim nào nhận diện được service account của VNAIP BE. Tắt sau khi đã
# ghi nhận xong.
# LOG_VERIFIED_CLAIMS=true

# --- GĐ1: embedding (OpenRouter) và Qdrant ---
# Hai tiến trình: web (`npm start`) chỉ nhận webhook và đẩy job vào Redis, KHÔNG cần
# các khoá OpenRouter/Qdrant bên dưới; worker (`npm run start:worker`) mới cần.
# Mock mode chỉ bật khi đặt "true". Không đặt nghĩa là dùng dịch vụ thật (và
# báo lỗi cấu hình nếu thiếu), để production không âm thầm chạy bằng dữ liệu giả.
EMBEDDING_MOCK_MODE=true
# OPENROUTER_API_KEY=__secret__
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# EMBEDDING_MODEL=openai/text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536
# EMBEDDING_TIMEOUT_MS=15000
# EMBEDDING_BATCH_SIZE=64

QDRANT_MOCK_MODE=true
# QDRANT_URL=https://<cluster-id>.<region>.<provider>.cloud.qdrant.io
# QDRANT_API_KEY=__secret__
# Mỗi môi trường một collection, ví dụ vnaip_dedup_stg và vnaip_dedup_prod.
# QDRANT_COLLECTION=vnaip_dedup_stg
# QDRANT_TIMEOUT_MS=10000

# Không còn datasetKey (bỏ 2026-11-04): mọi sáng kiến nằm chung một collection.
# `id` sáng kiến phải duy nhất trong toàn VNAIP.

# --- GĐ2: webhook index (VNAIP BE gọi thẳng, không qua Core) và worker ---
# Web và worker là hai tiến trình riêng, dùng CHUNG REDIS_URL, QUEUE_PREFIX, QUEUE_NAME
# (lệch một trong ba thì job nằm đó mà không ai xử lý) và nên cùng INDEX_MAX_ATTEMPTS.
# Web cần: WEBHOOK_API_KEYS + REDIS_URL.
# Worker cần: REDIS_URL + OPENROUTER_API_KEY + QDRANT_URL/API_KEY/COLLECTION.
# API key của webhook (chỉ web); nhiều key phân tách bằng dấu phẩy để đổi key không phải
# ngừng nhận event. Mỗi key tối thiểu 16 ký tự. Thiếu biến này thì webhook trả 503.
# WEBHOOK_API_KEYS=__secret__,__secret-moi__
# QUEUE_MOCK_MODE=true dùng hàng đợi trong bộ nhớ: job MẤT khi tiến trình tắt và không
# chia sẻ được giữa hai tiến trình, nên web tự chạy worker trong tiến trình và
# `npm run start:worker` từ chối chế độ này. Chỉ dùng cục bộ. Không đặt nghĩa là
# dùng BullMQ (cần REDIS_URL, nếu thiếu thì web trả 503 ở webhook còn worker thoát
# mã 1). Môi trường hosted PHẢI dùng BullMQ.
QUEUE_MOCK_MODE=true
# Redis tự host của BullMQ: bắt buộc rediss (TLS) trừ localhost. Phải đặt
# maxmemory-policy=noeviction; không dùng chung với Redis cache của BE. AOF đang tắt:
# Redis khởi động lại thì job đang chờ bị mất, BE cần gửi lại event chưa được index.
# REDIS_URL=rediss://<user>:<mật khẩu>@<host>:<port>/<db>
# Mỗi môi trường một tiền tố khoá nếu dùng chung Redis, ví dụ vnaip-dedup-stg.
# QUEUE_PREFIX=vnaip-dedup
# QUEUE_NAME=idea-index
# Job lỗi (tập failed) và job đã xong được giữ bao lâu; job chứa nội dung sáng kiến.
# QUEUE_FAILED_TTL_DAYS=14
# QUEUE_COMPLETED_TTL_SECONDS=3600
# QUEUE_PUBLISH_TIMEOUT_MS=10000
# QUEUE_MAX_JOB_BYTES=2000000
# Retry của worker: số lần thử tối đa và độ trễ (tăng gấp đôi mỗi lần, có trần).
# INDEX_MAX_ATTEMPTS=5
# INDEX_RETRY_BASE_MS=10000
# INDEX_RETRY_MAX_MS=300000

# --- MinIO (kho file của VNAIP) ---
# #TODO: VNAIP chưa có MinIO. Khi có, điền endpoint, bucket, access key và secret
# CHỈ ĐỌC, và chốt định dạng `fileRef` trong event. Worker chưa tải file.
# (Chỉ worker cần các biến MINIO_* khi làm xong phần file.)
# MINIO_ENDPOINT=#TODO
# MINIO_BUCKET=#TODO
# MINIO_ACCESS_KEY=#TODO
# MINIO_SECRET_KEY=#TODO
