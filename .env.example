# vnaip-dedup: no Sota secret or private key is required.
PORT=8787
# Public, non-secret override for local/self-hosted Core JWKS discovery.
# SOTA_CORE_ORIGIN=http://localhost:3651

# --- check-duplicates tool configuration ---
# Số ứng viên tối đa gửi từ VNAIP BE để chấm điểm. Giá trị khởi điểm chưa
# được tối ưu; chỉnh theo nhu cầu thực tế và deadline của tool (timeoutMs).
VNAIP_CANDIDATE_LIMIT=30

# Mock mode: "true" (mặc định) dùng dữ liệu/điểm giả để phát triển/test khi
# chưa có API contract thật. PHẢI đặt "false" trước khi dùng production, và
# chỉ sau khi đã cấu hình đủ biến bên dưới.
VNAIP_MOCK_MODE=true
LLM_MOCK_MODE=true

# VNAIP BE — cơ chế xác thực server-to-server THẬT chưa được xác nhận.
# KHÔNG dùng invocation JWT của SotaAgents cho chiều gọi này.
VNAIP_BE_BASE_URL=http://localhost:3000
# VNAIP_BE_SERVICE_TOKEN=__secret__
# VNAIP_BE_TIMEOUT_MS=5000

# Model/LLM provider — contract thật chưa được xác nhận (endpoint dưới đây
# giả định dạng OpenAI-compatible chat completion).
# LLM_SCORER_BASE_URL=https://llm-provider.example.com
# LLM_SCORER_API_KEY=__secret__
# LLM_SCORER_MODEL=__model-name__
# LLM_SCORER_TIMEOUT_MS=8000
# LLM_SCORER_BATCH_SIZE=10

# Tạm thời: ghi claims đã xác thực của mỗi lời gọi hợp lệ (không ghi token) để
# xem claim nào nhận diện được service account của VNAIP BE. Tắt sau khi đã
# ghi nhận xong.
# LOG_VERIFIED_CLAIMS=true
