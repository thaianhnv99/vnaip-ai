{
  "name": "vnaip-dedup",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:sota": "sota dev",
    "lint": "sota validate",
    "deploy": "sota deploy",
    "dev:backend": "tsx watch src/backend/server.ts",
    "build:backend": "tsc -p tsconfig.backend.json",
    "start": "node dist/backend/server.js",
    "start:worker": "node dist/backend/worker.js",
    "build": "tsc -p tsconfig.backend.json",
    "dev": "tsx watch src/backend/server.ts",
    "dev:worker": "tsx watch src/backend/worker.ts",
    "typecheck": "tsc -p tsconfig.backend.json --noEmit",
    "typecheck:tests": "tsc -p tsconfig.backend.tests.json --noEmit",
    "test": "tsx --test $(find src -name '*.test.ts' | sort)"
  },
  "dependencies": {
    "bullmq": "^6.6.0",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/node": "^24.19.2",
    "tsx": "^4.21.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=20.3"
  }
}
